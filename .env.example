PORT=3000
NODE_ENV=development

# Database URL (Matches docker-compose.yml configuration)
DATABASE_URL="postgresql://jameya_dev:jameya_dev_password@localhost:5422/jameya_dev_db?schema=public"

# Auth Secrets
JWT_ACCESS_SECRET="dev_access_secret_12345"
JWT_REFRESH_SECRET="dev_refresh_secret_12345"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# OTP Driver ('console' | 'email')
OTP_DRIVER="email"

# Admin JWT Secrets (separate from customer auth)
ADMIN_JWT_ACCESS_SECRET="admin_dev_access_secret_12345"
ADMIN_JWT_REFRESH_SECRET="admin_dev_refresh_secret_12345"
ADMIN_JWT_ACCESS_EXPIRATION="15m"
ADMIN_JWT_REFRESH_EXPIRATION="8h"

# SMTP Mailer Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="no-reply@jameya.app"

# Seed defaults (override in production)
SEED_ADMIN_EMAIL="admin@jameya.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
