PORT=3000
NODE_ENV=development

# Database URL (Matches docker-compose.yml configuration)
DATABASE_URL="postgresql://jameya_dev:jameya_dev_password@localhost:5422/jameya_dev_db?schema=public"

# Auth Secrets
JWT_ACCESS_SECRET="dev_access_secret_12345"
JWT_REFRESH_SECRET="dev_refresh_secret_12345"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# OTP Driver ('console' | 'email' | 'whatsapp')
OTP_DRIVER="whatsapp"

# Seed defaults (override in production)
SEED_ADMIN_EMAIL="admin@jameya.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
